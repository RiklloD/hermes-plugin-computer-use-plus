@@ -0,0 +1,74 @@
+import XCTest
+@testable import OpenComputerUseKit
+
+final class WriteVerificationTests: XCTestCase {
+    func testValueWriteConfirmedOnExactAndWhitespaceInsensitiveMatch() {
+        XCTAssertEqual(classifyValueWrite(requested: "Interview request", before: "", after: "Interview request"), .confirmed)
+        XCTAssertEqual(classifyValueWrite(requested: "a  b", before: nil, after: "a\u{00A0}b\u{200B}"), .confirmed)
+    }
+
+    func testValueWriteThatLeavesTheFieldAloneIsUnchanged() {
+        // The issue #83 repro: date steppers and selects that accept and ignore writes.
+        XCTAssertEqual(classifyValueWrite(requested: "15", before: "0", after: "0"), .unchanged("0"))
+        XCTAssertEqual(classifyValueWrite(requested: "Türkiye", before: "Seçiniz", after: "Seçiniz"), .unchanged("Seçiniz"))
+    }
+
+    func testUnchangedWinsOverContainmentWhenThePreviousValueAlreadyContainedTheRequest() {
+        XCTAssertEqual(classifyValueWrite(requested: "Hello", before: "Hello world", after: "Hello world"), .unchanged("Hello world"))
+    }
+
+    func testRewritingTheSameValueIsConfirmed() {
+        XCTAssertEqual(classifyValueWrite(requested: "same", before: "same", after: "same"), .confirmed)
+    }
+
+    func testNumericFormattingIsConfirmedAndOtherDifferencesReported() {
+        XCTAssertEqual(classifyValueWrite(requested: "1990", before: "0", after: "1,990"), .confirmed)
+        XCTAssertEqual(classifyValueWrite(requested: "abc", before: "", after: "ABD"), .differs("ABD"))
+        XCTAssertEqual(classifyValueWrite(requested: "abc", before: "", after: nil), .unreadable)
+    }
+
+    func testTextInsertionChecks() {
+        XCTAssertEqual(classifyTextInsertion(typed: " world", before: "hello", after: "hello world"), .confirmed)
+        XCTAssertEqual(classifyTextInsertion(typed: "a", before: "\n\nSent from Outlook for Mac", after: "\n\nSent from Outlook for Mac"),
+                       .unchanged("\n\nSent from Outlook for Mac"))
+        XCTAssertEqual(classifyTextInsertion(typed: "secret", before: "", after: "••••••"), .differs("••••••"))
+        XCTAssertEqual(classifyTextInsertion(typed: "x", before: nil, after: nil), .unreadable)
+        let long = String(repeating: "Dear Thomas, ", count: 20) + "Best, Lorik"
+        XCTAssertEqual(classifyTextInsertion(typed: long, before: "", after: long + "\n\nSent from Outlook for Mac"), .confirmed)
+    }
+
+    func testTreeDiffReportsOnlyChangedLines() throws {
+        let previous = (0..<40).map { "\t\($0) button B\($0)" } + ["\t40 text field Subject"]
+        let current = (0..<40).map { "\t\($0) button B\($0)" } + ["\t40 text field Subject Value: Hi"]
+        let diff = try XCTUnwrap(treeDiffLines(previous: previous, current: current))
+        XCTAssertEqual(diff.count, 3)
+        XCTAssertTrue(diff[0].contains("1 added, 1 removed"))
+        XCTAssertEqual(diff[1], "- 40 text field Subject")
+        XCTAssertEqual(diff[2], "+ 40 text field Subject Value: Hi")
+    }
+
+    func testTreeDiffFallsBackToTheFullTreeWhenIndexesShift() {
+        let previous = (0..<40).map { "\t\($0) button B\($0)" }
+        let current = ["\t0 dialog New"] + (0..<40).map { "\t\($0 + 1) button B\($0)" }
+        XCTAssertNil(treeDiffLines(previous: previous, current: current))
+    }
+
+    func testTreeDiffNoChangesAndEmptyInputs() {
+        let lines = ["\t0 window W", "\t1 button OK"]
+        XCTAssertEqual(treeDiffLines(previous: lines, current: lines)?.count, 1)
+        XCTAssertNil(treeDiffLines(previous: [], current: lines))
+    }
+
+    func testEnvironmentSwitches() {
+        XCTAssertEqual(actionResultMode(environment: [:]), .full)
+        XCTAssertEqual(actionResultMode(environment: ["OPEN_COMPUTER_USE_ACTION_RESULT": "Diff"]), .diff)
+        XCTAssertTrue(actionScreenshotEnabled(environment: [:]))
+        XCTAssertFalse(actionScreenshotEnabled(environment: ["OPEN_COMPUTER_USE_ACTION_SCREENSHOT": "0"]))
+    }
+
+    func testTextEntryMethodParsing() throws {
+        XCTAssertEqual(try parseTextEntryMethod(nil), .auto)
+        XCTAssertEqual(try parseTextEntryMethod(" Paste "), .paste)
+        XCTAssertThrowsError(try parseTextEntryMethod("clipboard"))
+    }
+}
