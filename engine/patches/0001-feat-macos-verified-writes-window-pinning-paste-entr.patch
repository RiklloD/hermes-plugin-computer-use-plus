+        var summaries: [String] = []
+        for window in windows where isUsableWindowElement(window) {
+            guard let id = SkyLightSPI.shared.windowID(for: window) else { continue }
+            let title = String((stringValue(of: window, attribute: kAXTitleAttribute) ?? "").prefix(60))
+            summaries.append("\(id) \(quoted(title))\(id == currentWindowID ? " (current)" : "")")
+            if summaries.count == 8 { break }
+        }
