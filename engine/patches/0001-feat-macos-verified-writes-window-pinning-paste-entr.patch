+    /// `id "title"` for each usable window, current one marked. At most 8, so a
+    /// browser with dozens of windows cannot flood the header.
+    private static func windowSummaries(appElement: AXUIElement, currentWindowID: CGWindowID?) -> [String] {
+        guard let windows = copyArray(appElement, attribute: kAXWindowsAttribute) else {
+            return []
