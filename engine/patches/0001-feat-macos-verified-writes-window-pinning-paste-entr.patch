+    /// The window whose title contains `title` (case-insensitive); an exact
+    /// match wins over a substring match.
+    static func windowID(matchingTitle title: String, for app: RunningAppDescriptor) -> CGWindowID? {
+        let appElement = AXUIElementCreateApplication(app.pid)
+        let needle = title.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+        guard !needle.isEmpty, let windows = copyArray(appElement, attribute: kAXWindowsAttribute) else {
+            return nil
+        }
+        let candidates = windows.filter(isUsableWindowElement(_:)).compactMap { window -> (CGWindowID, String)? in
+            guard let id = SkyLightSPI.shared.windowID(for: window) else { return nil }
+            return (id, (stringValue(of: window, attribute: kAXTitleAttribute) ?? "").lowercased())
+        }
+        return (candidates.first { $0.1 == needle } ?? candidates.first { $0.1.contains(needle) })?.0
+    }
