diff --git a/packages/OpenComputerUseKit/Sources/OpenComputerUseKit/WriteVerification.swift b/packages/OpenComputerUseKit/Sources/OpenComputerUseKit/WriteVerification.swift
new file mode 100644
index 0000000..7cb6683
--- /dev/null
+++ b/packages/OpenComputerUseKit/Sources/OpenComputerUseKit/WriteVerification.swift
@@ -0,0 +1,165 @@
+import ApplicationServices
+import Foundation
+
+/// How text gets into an app for type_text.
+public enum TextEntryMethod: String, CaseIterable, Sendable {
+    /// Accessibility write for native fields, keystrokes for web content, each
+    /// confirmed by reading the field back.
+    case auto
+    /// Keystrokes to the app's current keyboard focus, without requiring the
+    /// focused element to be visible to accessibility.
+    case keys
+    /// Clipboard + Cmd+V, restoring the previous clipboard afterwards. One event
+    /// for any length of text.
+    case paste
+}
+
+func parseTextEntryMethod(_ rawValue: String?) throws -> TextEntryMethod {
+    let normalized = rawValue?.trimmingCharacters(in: .whitespacesAndNewlines).lowercased() ?? TextEntryMethod.auto.rawValue
+    guard let method = TextEntryMethod(rawValue: normalized.isEmpty ? TextEntryMethod.auto.rawValue : normalized) else {
+        throw ComputerUseError.invalidArguments("method must be one of: \(TextEntryMethod.allCases.map(\.rawValue).joined(separator: ", "))")
+    }
+    return method
+}
+
+/// What reading a field back after a write says about the write.
+enum WriteCheck: Equatable {
+    /// The field now holds what was written.
+    case confirmed
+    /// The field changed, but not to exactly what was written (formatting,
+    /// masking, autocompletion).
+    case differs(String)
+    /// The field still holds its previous value: the write did nothing.
+    case unchanged(String)
+    /// The field's value is not readable, so the write cannot be confirmed.
+    case unreadable
+}
+
+/// The element's value as text, whatever CF type the app reports it as.
+func readableValue(of element: AXUIElement) -> String? {
+    var raw: CFTypeRef?
+    guard AXUIElementCopyAttributeValue(element, kAXValueAttribute as CFString, &raw) == .success, let raw else {
+        return nil
+    }
+    if let string = raw as? String { return string }
+    if let attributed = raw as? NSAttributedString { return attributed.string }
+    if CFGetTypeID(raw) == CFBooleanGetTypeID() { return CFBooleanGetValue((raw as! CFBoolean)) ? "1" : "0" }
+    if let number = raw as? NSNumber { return number.stringValue }
+    return nil
+}
+
+/// Whitespace-insensitive form used for comparisons: zero-width characters
+/// dropped, non-breaking spaces and runs of whitespace collapsed.
+func comparableText(_ text: String) -> String {
+    let dropped = text.unicodeScalars.filter { !["\u{200B}", "\u{200C}", "\u{200D}", "\u{FEFF}"].contains($0) }
+    let cleaned = String(String.UnicodeScalarView(dropped)).replacingOccurrences(of: "\u{00A0}", with: " ")
+    return cleaned.split(whereSeparator: { $0.isWhitespace }).joined(separator: " ")
+}
+
+private func numericValue(_ text: String) -> Double? {
+    Double(text.replacingOccurrences(of: ",", with: "").replacingOccurrences(of: "'", with: ""))
+}
+
+/// Classify a value replacement (set_value).
+func classifyValueWrite(requested: String, before: String?, after: String?) -> WriteCheck {
+    guard let after else { return .unreadable }
+    let wanted = comparableText(requested)
+    let now = comparableText(after)
+    if now == wanted { return .confirmed }
+    if let before, comparableText(before) == now { return .unchanged(after) }
+    if !wanted.isEmpty, now.contains(wanted) { return .confirmed }
+    if let a = numericValue(now), let b = numericValue(wanted), a == b { return .confirmed }
+    return .differs(after)
+}
+
+/// Classify an insertion (type_text): the field must have changed and should
+/// now contain the end of the typed text.
+func classifyTextInsertion(typed: String, before: String?, after: String?) -> WriteCheck {
+    guard let after else { return .unreadable }
+    let now = comparableText(after)
+    if let before, comparableText(before) == now {
+        return comparableText(typed).isEmpty ? .confirmed : .unchanged(after)
+    }
+    let tail = String(comparableText(typed).suffix(40))
+    if tail.isEmpty || now.contains(tail) { return .confirmed }
+    return .differs(after)
+}
+
+/// Poll the element until the write is confirmed or `timeout` elapses; apps
+/// commit edits asynchronously.
+func awaitWrite(
+    on element: AXUIElement,
+    timeout: TimeInterval = 0.4,
+    classify: (String?) -> WriteCheck
+) -> WriteCheck {
+    let deadline = ProcessInfo.processInfo.systemUptime + timeout
+    var check = classify(readableValue(of: element))
+    while check != .confirmed, ProcessInfo.processInfo.systemUptime < deadline {
+        Thread.sleep(forTimeInterval: 0.03)
+        check = classify(readableValue(of: element))
+    }
+    return check
+}
+
+func truncatedForMessage(_ text: String, limit: Int = 80) -> String {
+    let flat = comparableText(text)
+    return flat.count > limit ? String(flat.prefix(limit)) + "…" : flat
+}
+
+// MARK: - Action result diffs
+
+/// How an action reports the window afterwards.
+enum ActionResultMode: String {
+    /// The whole tree, as upstream does.
+    case full
+    /// Only the tree lines that changed, when the window is the same and few
+    /// lines changed; otherwise the whole tree.
+    case diff
+}
+
+func actionResultMode(environment: [String: String]) -> ActionResultMode {
+    let raw = environment["OPEN_COMPUTER_USE_ACTION_RESULT"]?.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+    return raw.flatMap(ActionResultMode.init(rawValue:)) ?? .full
+}
+
+func actionScreenshotEnabled(environment: [String: String]) -> Bool {
+    guard let raw = environment["OPEN_COMPUTER_USE_ACTION_SCREENSHOT"]?.trimmingCharacters(in: .whitespacesAndNewlines).lowercased() else {
+        return true
+    }
+    return !["0", "false", "no", "off"].contains(raw)
+}
+
+/// The changed lines between two renders of the same window, or nil when the
+/// whole tree should be returned instead. Lines carry their element index, so a
+/// line that is unchanged here also keeps its index: anything the caller learnt
+/// from the previous tree about unchanged lines stays valid.
+func treeDiffLines(previous: [String], current: [String], maxChanged: Int = 60) -> [String]? {
+    guard !previous.isEmpty, !current.isEmpty else { return nil }
+    var remaining = Dictionary(previous.map { ($0, 1) }, uniquingKeysWith: +)
+    var added: [String] = []
+    for line in current {
+        if let count = remaining[line], count > 0 {
+            remaining[line] = count - 1
+        } else {
+            added.append(line)
+        }
+    }
+    var removedBudget = remaining
+    var removed: [String] = []
+    for line in previous {
+        if let count = removedBudget[line], count > 0 {
+            removedBudget[line] = count - 1
+            removed.append(line)
+        }
+    }
+    let changed = added.count + removed.count
+    // Past a quarter of the tree the diff is no cheaper to read than the tree,
+    // and usually means indexes shifted.
+    guard changed <= maxChanged, changed * 4 <= max(current.count, previous.count) else { return nil }
+    if changed == 0 {
+        return ["(no accessibility tree changes; \(current.count) lines unchanged)"]
+    }
+    return ["(tree diff: \(added.count) added, \(removed.count) removed, \(current.count - added.count) unchanged lines omitted; indexes on unchanged lines are still valid)"]
+        + removed.map { "- " + $0.trimmingCharacters(in: .whitespaces) }
+        + added.map { "+ " + $0.trimmingCharacters(in: .whitespaces) }
+}
